# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_GENERATION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_GENERATION_REASONING=none
OPENROUTER_CONTROL_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_CONTROL_REASONING=none
OPENROUTER_JUDGE_MODEL=google/gemini-3-flash-preview
OPENROUTER_JUDGE_REASONING=high

# LangSmith is required for real model-backed evaluation and graph runs.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-study-partner

# Complete-scope summaries fail rather than truncate when this budget is exceeded.
SUMMARY_CONTEXT_WINDOW_TOKENS=64000
SUMMARY_MAX_OUTPUT_TOKENS=8000
SUMMARY_SAFETY_MARGIN_TOKENS=1000

# Local retrieval models use CPU unless explicitly changed. Set to "cuda" if
# a GPU is available (requires the CUDA-enabled torch build, see pyproject.toml).
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# Set to true once the embedding/reranker weights are cached locally to skip
# the Hugging Face Hub revision check on every cold load.
HF_LOCAL_FILES_ONLY=false
