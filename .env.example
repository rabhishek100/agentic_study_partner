# Postgres runtime connection. Use the direct URL for a persistent IPv6-capable
# backend, or Supavisor session mode when the host is IPv4-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct connection used by schema/backfill commands. Locally this is the same
# URL; hosted deployments should not use a transaction pooler for migrations.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used only by the Dockerized API to reach Supabase running on the host.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
DOCKER_SUPABASE_URL=http://host.docker.internal:54321

# Owner used by local CLI and evaluation commands only. Request handlers derive
# the owner from the verified access-token subject and never read this.
DEFAULT_OWNER_ID=00000000-0000-4000-8000-000000000001
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=10

# The identity provider. These used to be the SUPABASE_* names below, and were
# the same thing as object storage while both were one project; since the
# database moved to Railway they are not, so a variable that meant two things
# had to split. The old names are still read for one release, with a warning.
#
# AUTH_JWT_SECRET is only for projects still signing with a shared HS256
# secret, which includes the local Supabase CLI stack. Asymmetric projects
# publish JWKS and the API fetches it. Override the issuer or audience only
# when they differ from <AUTH_SUPABASE_URL>/auth/v1 and "authenticated".
AUTH_SUPABASE_URL=http://127.0.0.1:54321
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Deprecated aliases for the four above. Remove once every environment has
# moved; the API logs a warning naming the variable, never its value.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# Server-side Supabase Storage access, for as long as source PDFs live there.
# Needed by the legacy source-storage backend and by the migration's read
# path; not needed once SOURCE_STORAGE_BACKEND=r2 everywhere. Must never reach
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Compose build inputs. `scripts/local.sh setup` replaces the key with the
# value reported by the local Supabase CLI; this publishable key is not a
# server secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Ingestion limits. Sources and page counts above these are rejected before any
# expensive work. A 1,000-page book parses in bounded page batches; the source
# cap is enforced in the browser, the bucket, the API, and the worker, so
# changing it means changing all four.
INGESTION_SOURCE_BUCKET=book-sources
# Which provider holds source and viewer PDFs: supabase, r2, or filesystem.
# Existing rows are read through the backend each row records, so both can be
# live while the migration runs. New rows use this.
#
# The bucket must not be the video or book-figure bucket. Each of those has a
# retention sweep that deletes objects its own rows do not name, and source
# PDFs sitting in one are exactly that; the configuration refuses it.
SOURCE_STORAGE_BACKEND=supabase
SOURCE_STORAGE_ROOT=data/book-sources
# Connection details fall back to the VIDEO_S3_* pair when unset, since the
# buckets share an account and endpoint. The bucket never falls back.
SOURCE_S3_BUCKET=
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
INGESTION_MAX_SOURCE_BYTES=52428800
INGESTION_MAX_PAGES=1000
INGESTION_MAX_QUEUED_JOBS_PER_OWNER=3
INGESTION_WORKER_POLL_SECONDS=5
INGESTION_LEASE_SECONDS=300
INGESTION_TEMP_ROOT=

# Local development defaults to owner-scoped filesystem media. Production can
# use a private Cloudflare R2 bucket through its S3-compatible endpoint. Keep
# these credentials server-side; neither endpoint nor key is sent to browsers.
VIDEO_MEDIA_BACKEND=filesystem
VIDEO_WORKER_STAGES=
VIDEO_YTDLP_HTTP_CHUNK_SIZE_BYTES=5242880
VIDEO_MEDIA_ROOT=data/video-media
VIDEO_MEDIA_CACHE_ROOT=
VIDEO_S3_BUCKET=
VIDEO_S3_ENDPOINT=
VIDEO_S3_ACCESS_KEY_ID=
VIDEO_S3_SECRET_ACCESS_KEY=
VIDEO_S3_REGION=auto
VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_YTDLP_BINARY=yt-dlp
VIDEO_FFPROBE_BINARY=ffprobe
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_TESSERACT_BINARY=tesseract
VIDEO_ACQUISITION_TIMEOUT_SECONDS=1800
VIDEO_INGESTION_LEASE_SECONDS=300
VIDEO_INGESTION_TEMP_ROOT=

# Video retention, run by the worker on the book cleanup interval. The grace
# window is what stops the orphan sweep racing an ingest that has written its
# media but not yet committed the row naming it; shorten it with care.
# Set VIDEO_CLEANUP_DRY_RUN=1 to make every pass report what it would remove
# and remove nothing — do this for the first deploy against an existing
# volume, then unset it. See docs/deployment.md.
VIDEO_ABANDONED_UPLOAD_HOURS=24
VIDEO_STAGING_RETENTION_DAYS=7
VIDEO_MEDIA_ORPHAN_GRACE_HOURS=24

# Both retention sweeps refuse to act on a database that cannot account for
# what storage holds: no referenced objects at all, or an unreferenced share
# past this ceiling, measured only once an owner has at least this many
# eligible objects. This is what stops a sweep run against a restored dump, a
# half-migrated copy, or a test database from deleting the live library.
STORAGE_CLEANUP_MAX_ORPHAN_FRACTION=0.25
STORAGE_CLEANUP_ORPHAN_GUARD_MINIMUM=20

# Book figures. They were 52% of the database as base64 text, and are now
# objects addressed by key. "filesystem" needs nothing else and is the local
# default; "r2" needs a bucket that is NOT the video bucket, because video's
# retention sweep deletes whatever no video row names. Endpoint, region and
# credentials fall back to the VIDEO_S3_* ones, since both buckets live in the
# same account.
BOOK_IMAGE_BACKEND=filesystem
BOOK_IMAGE_ROOT=data/book-images
# BOOK_IMAGE_S3_BUCKET=agentic-study-partner-book-media-prod
# BOOK_IMAGE_CACHE_ROOT=data/book-image-cache
VIDEO_CLEANUP_DRY_RUN=

# Retention. Reserved paths whose upload never completed are cancelled after
# the abandonment window; failed and cancelled jobs keep their source objects
# through the retention window so a manual retry can reuse them. Ready books
# keep their sources indefinitely.
INGESTION_ABANDONED_UPLOAD_HOURS=24
INGESTION_SOURCE_RETENTION_DAYS=7
INGESTION_CLEANUP_INTERVAL_SECONDS=3600

# Parser tuning. Ordinary pages always use the hi-res parser. A page above the
# vector-drawing ceiling uses native text plus a rendered visual so a generated
# plot cannot hold one worker process indefinitely.
PARSER_MAX_VECTOR_DRAWINGS=20000

# Optional file copy of the worker's structured JSON logs.
WORKER_LOG_FILE=

OPENROUTER_API_KEY=
OPENROUTER_REQUEST_TIMEOUT_SECONDS=120
OPENROUTER_GENERATION_MAX_RETRIES=2
# Interactive interview turns fail fast and let the UI reconcile the saved
# session instead of holding the answer composer for minutes.
OPENROUTER_INTERVIEW_TIMEOUT_SECONDS=15
OPENROUTER_INTERVIEW_MAX_RETRIES=0
OPENROUTER_JUDGE_MAX_RETRIES=1
OPENROUTER_GENERATION_MODEL=openai/gpt-5.6-luna
OPENROUTER_GENERATION_REASONING=none
OPENROUTER_CONTROL_MODEL=openai/gpt-5.6-luna
OPENROUTER_CONTROL_REASONING=low
OPENROUTER_JUDGE_MODEL=google/gemini-3-flash-preview
OPENROUTER_JUDGE_REASONING=high
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENROUTER_RERANKER_MODEL=cohere/rerank-4-pro
# Video ingestion prefers free YouTube captions. Whisper is called only when
# captions are missing or cover less than 90% of the lecture. At $0.006/minute
# it leaves enough of the $0.50 ad-hoc cap for the benchmarked frame analysis.
# The same model transcribes questions dictated into the composer, which are
# seconds long and capped at two minutes each.
OPENROUTER_AUDIO_MODEL=openai/whisper-1
OPENROUTER_AUDIO_COST_PER_MINUTE_USD=0.006
# Live interviews use Luna for grounded question/evaluation turns, low-cost
# Whisper Turbo for ephemeral answer clips, and Voxtral for interviewer speech.
# The provider-reported USD total is canonical; the browser's INR display is
# only an estimate. Raw audio and screen checkpoints are never persisted.
OPENROUTER_INTERVIEW_MODEL=openai/gpt-5.6-luna
OPENROUTER_INTERVIEW_REASONING=low
OPENROUTER_INTERVIEW_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603
OPENROUTER_TTS_VOICE=en_paul_neutral
OPENROUTER_TTS_PRICE_PER_CHARACTER_USD=0.000016
OPENROUTER_TTS_TIMEOUT_SECONDS=15
OPENROUTER_VIDEO_VISION_MODEL=openai/gpt-5.6-luna
# Video evidence vectors. Text uses the same embedding model as books so one
# hosted model serves both libraries. Diagram and drawing crops are the only
# images embedded, in a separate multimodal space that also embeds the
# question, so a drawing stays findable when no nearby words name it.
OPENROUTER_VIDEO_TEXT_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENROUTER_VIDEO_IMAGE_EMBEDDING_MODEL=google/gemini-embedding-2
# Transcribing scanned pages. Qwen is primary on measured evidence, not
# reputation: scored against references written from the page images the two
# tie on character error (0.1473 vs 0.1480 over 35 pages) and Qwen costs about
# a sixth as much. Gemini stays the fallback and the second opinion on flagged
# pages, which is where it measures better.
# See evaluation/transcription_measurement.md.
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_OCR_FALLBACK_MODEL=google/gemini-3-flash-preview

# Complete-scope summaries fail instead of truncating beyond this budget.
SUMMARY_CONTEXT_WINDOW_TOKENS=64000
SUMMARY_MAX_OUTPUT_TOKENS=8000
SUMMARY_SAFETY_MARGIN_TOKENS=1000

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-study-partner

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
