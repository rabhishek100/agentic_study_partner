# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_GENERATION_MODEL=openai/gpt-5.6-luna
OPENROUTER_CONTROL_MODEL=x-ai/grok-4.5
OPENROUTER_CONTROL_REASONING=high

# LangSmith is required for real model-backed evaluation and graph runs.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-study-partner

# Complete-scope summaries fail rather than truncate when this budget is exceeded.
SUMMARY_CONTEXT_WINDOW_TOKENS=64000
SUMMARY_MAX_OUTPUT_TOKENS=8000
SUMMARY_SAFETY_MARGIN_TOKENS=1000

# Local retrieval models use CPU unless explicitly changed.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
