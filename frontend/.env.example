# FastAPI origin. Do not include the trailing /api path.
BACKEND_URL=http://127.0.0.1:8000
# Experimental interview media transport; requires the backend flag and worker.
# This is a build-time flag: restart dev or rebuild after changing it.
NEXT_PUBLIC_INTERVIEW_LIVEKIT_ENABLED=false

# Supabase project the browser talks to directly for sign-in and resumable
# uploads. The anon key is a publishable client credential protected by RLS;
# the service-role key must never appear here. The local values below are the
# Supabase CLI's well-known development defaults.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Display-only conversion for live interview cost. Provider-reported USD is
# the stored value; update this periodically rather than treating it as FX data.
NEXT_PUBLIC_USD_INR_RATE=90
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional one-click public demo. NEXT_PUBLIC values are visible in the built
# browser bundle: use only a disposable, restricted demo account here, never a
# personal or operator account. Leave either value blank to hide the button.
NEXT_PUBLIC_DEMO_LOGIN_EMAIL=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=
