---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	inventory(inventory)
	compose(compose)
	validate(validate)
	render(render)
	judge(judge)
	__end__([<p>__end__</p>]):::last
	__start__ --> inventory;
	compose -.-> validate;
	inventory -.-> compose;
	judge -. &nbsp;done&nbsp; .-> __end__;
	judge -.-> compose;
	render -.-> compose;
	render -.-> judge;
	validate -.-> compose;
	validate -.-> render;
	compose -.-> compose;
	classDef default fill:#f3f4f6,color:#111827,stroke:#6b7280,line-height:1.2
	classDef first fill:#dbeafe,color:#111827,stroke:#2563eb,line-height:1.2
	classDef last fill:#dcfce7,color:#111827,stroke:#15803d,line-height:1.2
