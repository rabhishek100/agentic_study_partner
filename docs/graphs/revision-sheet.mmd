---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	inventory(inventory)
	compose(compose)
	validate(validate)
	render(render)
	judge(judge)
	__end__([<p>__end__</p>]):::last
	__start__ --> inventory;
	compose -.-> validate;
	inventory -.-> compose;
	judge -. &nbsp;done&nbsp; .-> __end__;
	judge -.-> compose;
	render -.-> compose;
	render -.-> judge;
	validate -.-> compose;
	validate -.-> render;
	compose -.-> compose;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
